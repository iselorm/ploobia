# Copy to .env for a local pilot build, or set these as Cloudflare Pages
# environment variables. All of them are read at BUILD time, not run time —
# changing one means a rebuild.

# Show the in-app "Tell us" report tab. Leave unset for a public build.
VITE_PILOT=1

# Where reports POST. Leave unset and the app falls back to clipboard + mailto,
# which is a perfectly good way to run the first round.
# VITE_FEEDBACK_URL=/api/feedback

# Address the mailto fallback opens.
VITE_FEEDBACK_EMAIL=hello@ploobia.com

# Let search engines in. Unset keeps robots.txt at Disallow: / for an
# unlisted pilot.
# PLOOBIA_INDEXABLE=1

# Stamped into every pilot report so you know which build it came from.
# CI sets this to the commit sha.
# PLOOBIA_BUILD=abc1234
